@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/GPUBosciaCoreTargets.cmake")
set(GPUBoscia_Core_FOUND TRUE)
set(GPUBoscia_CUDA_FOUND @GPUBOSCIA_ENABLE_CUDA@)

# The normal package is the GPU solver; Core is an explicit CPU-only opt-in.
if(NOT GPUBoscia_FIND_COMPONENTS)
    set(GPUBoscia_FIND_COMPONENTS CUDA)
    set(GPUBoscia_FIND_REQUIRED_CUDA TRUE)
endif()
foreach(_gpuboscia_component IN LISTS GPUBoscia_FIND_COMPONENTS)
    if(_gpuboscia_component STREQUAL "CUDA")
        if(GPUBoscia_CUDA_FOUND)
            find_dependency(CUDAToolkit)
            include("${CMAKE_CURRENT_LIST_DIR}/GPUBosciaTargets.cmake")
        else()
            set(GPUBoscia_NOT_FOUND_MESSAGE "This GPUBoscia installation was built without CUDA; request COMPONENTS Core or install a CUDA-enabled build.")
        endif()
    elseif(NOT _gpuboscia_component STREQUAL "Core")
        set(GPUBoscia_${_gpuboscia_component}_FOUND FALSE)
        set(GPUBoscia_NOT_FOUND_MESSAGE "Unknown GPUBoscia component: ${_gpuboscia_component}. Available components: Core, CUDA.")
    endif()
endforeach()
check_required_components(GPUBoscia)
